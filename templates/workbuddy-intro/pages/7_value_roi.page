pageType: content
background:
  type: solid
  color: "$white"
elements:
  - elementId: top-label
    elementType: text
    bounds: [60, 42, 500, 18]
    content:
      style: "$label"
      text: "06 · BUSINESS VALUE & ROI"
  - elementId: page-title
    elementType: text
    bounds: [60, 64, 800, 38]
    content:
      style: "$pageTitle"
      text: "重塑人机协同范式，释放数倍生产力潜能"
  - elementId: page-subtitle
    elementType: text
    bounds: [60, 104, 800, 22]
