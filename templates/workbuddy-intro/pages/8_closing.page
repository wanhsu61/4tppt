pageType: final
background:
  type: solid
  color: "$white"
elements:
  - elementId: top-meta
    elementType: text
    bounds: [60, 42, 500, 18]
    content:
      fontSize: 10
      color: "$grayMuted"
      bold: true
      letterSpacing: 3
      text: "07 · THE FUTURE OF WORK"
  - elementId: top-rule
    elementType: line
    bounds: [60, 68, 840, 1]
    viewBox: [840, 1]
    points: "0,0.5 840,0.5"
    border: {style: solid, width: 1, color: "$grayBorder"}
  - elementId: center-container
    elementType: shape
    bounds: [120, 100, 720, 340]
    shapeName: rect
    fill: {type: solid, color: "$grayLight"}
    border: {style: solid, width: 1, color: "$grayBorder"}
  - elementId: center-tag
    elementType: text
    bounds: [140, 128, 680, 20]
    content:
      fontSize: 11
      color: "$accent"
      bold: true
      align: [center, middle]
      letterSpacing: 2
      text: "THE NEW ERA OF HUMAN-AI COLLABORATION"
  - elementId: final-title
    elementType: text
    bounds: [140, 158, 680, 50]
    content:
      style: "$sectionTitle"
      align: [center, middle]
      text: "开启人机协同办公新时代"
  - elementId: final-subtitle
    elementType: text
    bounds: [140, 212, 680, 26]
    content:
      fontSize: 17
      color: "$primary"
      bold: true
      align: [center, middle]
      letterSpacing: 1
      text: "WorkBuddy · 让工作更自由，让交付更敏捷"
