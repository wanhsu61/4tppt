pageType: content
background:
  type: solid
  color: "$white"
elements:
  - elementId: top-label
    elementType: text
    bounds: [60, 42, 500, 18]
    content:
      style: "$label"
      text: "04 · PRODUCTION CASES"
  - elementId: page-title
    elementType: text
    bounds: [60, 64, 800, 38]
    content:
      style: "$pageTitle"
      text: "深入核心业务骨髓的四大生产力应用实践"
  - elementId: page-subtitle
    elementType: text
    bounds: [60, 104, 800, 22]
