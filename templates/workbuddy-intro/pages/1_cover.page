pageType: cover
background:
  type: solid
  color: "$white"
elements:
  - elementId: top-meta
    elementType: text
    bounds: [60, 42, 500, 18]
    content:
      fontSize: 10
      color: "$grayMuted"
      bold: true
      letterSpacing: 3
      text: "VOL. 2026 · AI AGENT MONOGRAPH"
  - elementId: top-rule
    elementType: line
    bounds: [60, 68, 840, 1]
    viewBox: [840, 1]
    points: "0,0.5 840,0.5"
    border: {style: solid, width: 1, color: "$grayBorder"}
  - elementId: cover-tag
    elementType: text
    bounds: [60, 105, 600, 20]
    content:
      fontSize: 11
      color: "$accent"
      bold: true
      letterSpacing: 2
      text: "TENCENT CLOUD · DIGITAL COWORKER ARCHITECTURE"
  - elementId: cover-title
    elementType: text
    bounds: [60, 132, 800, 75]
    content:
      style: "$coverTitle"
      align: [left, middle]
      text: "WorkBuddy"
  - elementId: cover-subtitle
    elementType: text
    bounds: [60, 208, 800, 36]
    content:
      fontSize: 22
      color: "$primary"
      bold: true
      letterSpacing: 1
      text: "全场景 AI Agent 协同办公平台 · 数字同事"
  - elementId: accent-bar
    elementType: shape
    bounds: [60, 258, 48, 2]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: cover-lead
    elementType: text
    bounds: [60, 275, 760, 52]
    content:
      fontSize: 14
      color: "$grayText"
      lineHeight: 1.7
